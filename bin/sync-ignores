#!/usr/bin/env bash
#
# Regenerate the managed blocks in .gitignore and .ignore from repos.yml.
#
# These two files must disagree, and both are required:
#
#   .gitignore  excludes the children, so `git add -A` at this root cannot
#               stage them as gitlinks. The workspace repo tracks the specs.
#   .ignore     re-includes them for ripgrep, which outranks .gitignore for it
#               and is what the agent's Grep is built on. Git never reads
#               .ignore, so the exclusion still holds where it matters.
#
# Drop either one and you lose something: without .gitignore the workspace
# stages gitlinks, without .ignore the agent cannot read the code it is meant
# to be implementing into.
#
# Anything you write outside the markers is preserved. Idempotent.

set -uo pipefail

ROOT="$(CDPATH="" cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BEGIN="# >>> workspace repos — generated by bin/sync-ignores, do not edit >>>"
END="# <<< workspace repos <<<"

dirs="$("$ROOT/bin/repos" dirs)" || exit 1
[ -n "$dirs" ] || { echo "repos.yml declares no repository — nothing to sync" >&2; exit 1; }

sync_file() {
  local name="$1" prefix="$2"
  local path="$ROOT/$name" tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/sync-ignores.XXXXXX")" || return 1

  if [ -f "$path" ]; then
    awk -v b="$BEGIN" -v e="$END" '
      $0 == b { skip = 1; next }
      $0 == e { skip = 0; next }
      !skip   { print }
    ' "$path" | awk '
      /^[[:space:]]*$/ { pending = pending "\n"; next }
      { printf "%s%s\n", pending, $0; pending = "" }
    ' > "$tmp"
  fi

  [ -s "$tmp" ] && printf '\n' >> "$tmp"
  printf '%s\n' "$BEGIN" >> "$tmp"
  printf '%s\n' "$dirs" | while IFS= read -r dir; do
    [ -n "$dir" ] && printf '%s/%s/\n' "$prefix" "$dir" >> "$tmp"
  done
  printf '%s\n' "$END" >> "$tmp"

  if [ -f "$path" ] && cmp -s "$tmp" "$path"; then
    rm -f "$tmp"
    echo "$name already in sync"
    return 0
  fi
  if mv "$tmp" "$path"; then
    echo "$name updated ($(printf '%s\n' "$dirs" | grep -c .) repos)"
  else
    rm -f "$tmp"
    echo "could not write $name" >&2
    return 1
  fi
}

failures=0
sync_file .gitignore "" || failures=$((failures + 1))
sync_file .ignore "!" || failures=$((failures + 1))
[ "$failures" -eq 0 ] || exit 1
